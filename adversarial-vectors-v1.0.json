{
  "$schema": "https://openoba.com/erdl/adversarial-vectors-v1.0/schema.json",
  "spec": "erdl-language-spec-v2.3.md",
  "spec_commit": "cc53097aa885f2e9cd3bcfe2e1b02753fff30c5e",
  "category": "V-AV",
  "version": "v1.0.0",
  "created": "2026-10-07",
  "maintainer": "OpenOBA (https://openoba.com)",
  "description": "Delegated-authority adversarial conformance vectors (AV-01~16, INV-01~05, SPEC §6b). Each vector carries an ERDL rule (when → DENY), an attack context (violating the invariant), a legal context (non-violating baseline), and the expected attribution. Proposed by Ravindra Annam, refined through technical review with OpenOBA.",
  "vectors": [
    {
      "id": "AV-01",
      "family": "delegated-authority",
      "profile": "stateless",
      "invariant": "INV-01",
      "description": "Direct amplification: P grants A effective L2; A delegates to B; B standing L3; B attempts an L3 action under the L2 task.",
      "rule": {
        "id": "INV-01_authority_non_amplification",
        "name": "INV-01_authority_non_amplification",
        "description": "A delegatee must not exercise task authority exceeding the delegator's effective authority",
        "category": "security",
        "conditions": [
          {
            "expr": {
              "gt": [
                {
                  "field": "request.level"
                },
                {
                  "field": "authorized.level"
                }
              ]
            }
          }
        ],
        "conditionLogic": "AND",
        "action": {
          "decision": "DENY",
          "reason": "requested autonomy level exceeds the delegated effective authority (INV-01)"
        },
        "priority": 1,
        "enabled": true
      },
      "attack": {
        "request.level": 3,
        "authorized.level": 2
      },
      "legal": {
        "request.level": 2,
        "authorized.level": 2
      },
      "attribution": {
        "originating_task": "T-refund-0891",
        "authority_provenance": "P→A→B",
        "violation_hop": "A→B",
        "requested_action": "refund(level=L3)",
        "effective_authority": "refund(level=L2)",
        "reason": "AUTHORITY_NON_AMPLIFICATION"
      }
    },
    {
      "id": "AV-02",
      "family": "delegated-authority",
      "profile": "stateless",
      "invariant": "INV-01",
      "description": "Transitive authority amplification: P→A(L2)→B(L2)→C where C holds L3 standing privileges. Each hop is locally valid, but C's L3 request exceeds the L2 authority transmitted end-to-end through the chain. NOTE: Annam's matrix marks AV-02 as INV-01 + INV-02 — the INV-02 provenance dimension (end-to-end lineage detection) is a supporting invariant, not encoded in the single-valued invariant field (INV-01 primary).",
      "rule": {
        "id": "INV-01_transitive_amplification",
        "name": "INV-01_transitive_amplification",
        "description": "End-to-end effective authority must not exceed the authority transmitted through the delegation chain",
        "category": "security",
        "conditions": [
          {
            "expr": {
              "gt": [
                {
                  "field": "request.level"
                },
                {
                  "field": "hop_2_level"
                }
              ]
            }
          }
        ],
        "conditionLogic": "AND",
        "action": {
          "decision": "DENY",
          "reason": "transitive amplification: end-to-end effective authority exceeds the delegated authority (INV-01)"
        },
        "priority": 1,
        "enabled": true
      },
      "attack": {
        "hop_0_level": 2,
        "hop_1_level": 2,
        "hop_2_level": 2,
        "request.level": 3
      },
      "legal": {
        "hop_0_level": 2,
        "hop_1_level": 2,
        "hop_2_level": 2,
        "request.level": 2
      },
      "attribution": {
        "originating_task": "T-refund-0892",
        "authority_provenance": "P→A→B→C",
        "violation_hop": "B→C",
        "requested_action": "refund(level=L3)",
        "effective_authority": "refund(level=L2)",
        "reason": "TRANSITIVE_AUTHORITY_AMPLIFICATION"
      }
    },
    {
      "id": "AV-03",
      "family": "delegated-authority",
      "profile": "stateless",
      "invariant": "INV-01",
      "description": "Privileged delegate laundering: Agent A is not authorized to perform action write; Agent B independently possesses write standing. A delegates to B to cause B to perform write, laundering B's broader privilege into the task.",
      "rule": {
        "id": "INV-01_privileged_delegate_laundering",
        "name": "INV-01_privileged_delegate_laundering",
        "description": "A delegatee's independent standing privileges must not become available to the delegated task",
        "category": "security",
        "conditions": [
          {
            "expr": {
              "ne": [
                {
                  "field": "request.action"
                },
                {
                  "field": "effective.action"
                }
              ]
            }
          }
        ],
        "conditionLogic": "AND",
        "action": {
          "decision": "DENY",
          "reason": "privileged delegate laundering: delegatee exercised standing privilege outside the delegated authority (INV-01)"
        },
        "priority": 1,
        "enabled": true
      },
      "attack": {
        "effective.action": "read",
        "request.action": "write"
      },
      "legal": {
        "effective.action": "read",
        "request.action": "read"
      },
      "attribution": {
        "originating_task": "T-report-0903",
        "authority_provenance": "P→A→B",
        "violation_hop": "A→B",
        "requested_action": "write(Resource-R)",
        "effective_authority": "read(Resource-R)",
        "reason": "PRIVILEGED_DELEGATE_LAUNDERING"
      }
    },
    {
      "id": "AV-04",
      "family": "delegated-authority",
      "profile": "stateless",
      "invariant": "INV-03",
      "description": "Downstream constraint removal: P grants amount<=500; A delegates to B preserving it; B delegates to C widening amount to 5000.",
      "rule": {
        "id": "INV-03_narrow_only_inheritance",
        "name": "INV-03_narrow_only_inheritance",
        "description": "A downstream delegation must not widen an inherited constraint",
        "category": "security",
        "conditions": [
          {
            "expr": {
              "gt": [
                {
                  "field": "downstream.amount"
                },
                {
                  "field": "inherited.amount"
                }
              ]
            }
          }
        ],
        "conditionLogic": "AND",
        "action": {
          "decision": "DENY",
          "reason": "downstream constraint widens the inherited amount (INV-03)"
        },
        "priority": 1,
        "enabled": true
      },
      "attack": {
        "downstream.amount": 5000,
        "inherited.amount": 500
      },
      "legal": {
        "downstream.amount": 250,
        "inherited.amount": 500
      },
      "attribution": {
        "originating_task": "T-refund-0891",
        "authority_provenance": "P→A→B→C",
        "violation_hop": "B→C",
        "requested_action": "refund(amount=5000)",
        "effective_authority": "refund(amount=500)",
        "reason": "CONSTRAINT_NARROW_ONLY_VIOLATION"
      }
    },
    {
      "id": "AV-05",
      "family": "delegated-authority",
      "profile": "snapshot",
      "invariant": "INV-04",
      "description": "Revoked ancestor: P→A→B→C where C holds unexercised derived authority. P revokes the authorization granted to A; C then attempts to exercise the previously delegated authority.",
      "rule": {
        "id": "INV-04_enforcement_boundary_revocation",
        "name": "INV-04_enforcement_boundary_revocation",
        "description": "Authority derived solely from a revoked upstream authorization must not be exercised after the revocation",
        "category": "security",
        "conditions": [
          {
            "expr": {
              "gt": [
                {
                  "epoch_ms": {
                    "field": "request_t"
                  }
                },
                {
                  "epoch_ms": {
                    "field": "revocation_t"
                  }
                }
              ]
            }
          }
        ],
        "conditionLogic": "AND",
        "action": {
          "decision": "DENY",
          "reason": "derived authority exercised after upstream revocation (INV-04)"
        },
        "priority": 1,
        "enabled": true
      },
      "attack": {
        "revocation_t": "2026-01-01T01:00:00Z",
        "request_t": "2026-01-01T02:00:00Z"
      },
      "legal": {
        "revocation_t": "2026-01-01T01:00:00Z",
        "request_t": "2026-01-01T00:30:00Z"
      },
      "attribution": {
        "originating_task": "T-delegate-0905",
        "authority_provenance": "P→A→B→C",
        "violation_hop": "P→A",
        "requested_action": "exercise(derived-authority)",
        "effective_authority": "revoked (P→A revoked)",
        "reason": "ENFORCEMENT_BOUNDARY_REVOCATION"
      }
    },
    {
      "id": "AV-06",
      "family": "delegated-authority",
      "profile": "stateless",
      "invariant": "INV-05",
      "description": "Capability-boundary laundering: B is authorized read(R) only; B invokes Skill S, S invokes Tool T, T (standing capability write) attempts write against R. NOTE: Annam's matrix marks AV-06 with primary INV-05 and supporting INV-01/02/03 (non-amplification, provenance, constraint inheritance) — the supporting invariants are not encoded in the single-valued invariant field (INV-05 primary).",
      "rule": {
        "id": "INV-05_capability_boundary_non_amplification",
        "name": "INV-05_capability_boundary_non_amplification",
        "description": "A downstream component's standing capability must not become task authority",
        "category": "security",
        "conditions": [
          {
            "expr": {
              "ne": [
                {
                  "field": "request.action"
                },
                {
                  "field": "authorized.action"
                }
              ]
            }
          }
        ],
        "conditionLogic": "AND",
        "action": {
          "decision": "DENY",
          "reason": "requested action differs from the authorized action (INV-05)"
        },
        "priority": 1,
        "enabled": true
      },
      "attack": {
        "request.action": "write",
        "authorized.action": "read"
      },
      "legal": {
        "request.action": "read",
        "authorized.action": "read"
      },
      "attribution": {
        "originating_task": "T-audit-0421",
        "authority_provenance": "P→A→B→S→T→R",
        "violation_hop": "T→R",
        "requested_action": "write(Resource-R)",
        "effective_authority": "read(Resource-R)",
        "reason": "CAPABILITY_BOUNDARY_AUTHORITY_AMPLIFICATION"
      }
    },
    {
      "id": "AV-07",
      "family": "delegated-authority",
      "profile": "stateless",
      "invariant": "INV-01",
      "description": "Delegation depth violation: the implementation permits at most 3 agent-to-agent delegation edges (A→B→C→D is valid). D delegates to E, creating a 4th edge that exceeds the configured depth limit. NOTE: Annam's AV-07 has two attack variants — depth-limit exceeded (covered here) and loop/repeated-element (A→B→C→B, not yet covered).",
      "rule": {
        "id": "INV-01_delegation_depth",
        "name": "INV-01_delegation_depth",
        "description": "A delegation chain must not exceed the configured maximum delegation depth",
        "category": "security",
        "conditions": [
          {
            "expr": {
              "gt": [
                {
                  "field": "chain_depth"
                },
                {
                  "field": "max_depth"
                }
              ]
            }
          }
        ],
        "conditionLogic": "AND",
        "action": {
          "decision": "DENY",
          "reason": "delegation chain depth exceeds the configured maximum (INV-01 depth/loop safety)"
        },
        "priority": 1,
        "enabled": true
      },
      "attack": {
        "chain_depth": 4,
        "max_depth": 3
      },
      "legal": {
        "chain_depth": 3,
        "max_depth": 3
      },
      "attribution": {
        "originating_task": "T-delegate-0907",
        "authority_provenance": "A→B→C→D→E",
        "violation_hop": "D→E",
        "requested_action": "delegate(D→E)",
        "effective_authority": "max depth 3 (4 edges attempted)",
        "reason": "DELEGATION_DEPTH_VIOLATION"
      }
    },
    {
